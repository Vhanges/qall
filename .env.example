# Local development environment.
# Copy to `.env.local` and adjust. `.env*` is gitignored, so this stays local.
#   cp .env.example .env.local

# n8n webhook that owns the chat logic. Must match the workflow's path exactly.
# The QALL workflow serves `/webhook/qall` (NOT `/webhook/qall-marketing`).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/qall