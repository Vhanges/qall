# Local development environment.
# Copy to `.env.local` and adjust. `.env*` is gitignored, so this stays local.
#   cp .env.example .env.local

# n8n webhook that owns the chat logic. Must match the workflow's path exactly.
# The QALL workflow serves `/webhook/qall` (NOT `/webhook/qall-marketing`).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/qall

# Shared secret for the n8n webhook's Header Auth, sent as the `X-QALL-Key`
# header from the server only. Must match the n8n `httpHeaderAuth` credential
# value exactly. Generate with: openssl rand -hex 32
# Server-side only: do NOT add a NEXT_PUBLIC_ prefix, or it ships to the browser.
QALL_WEBHOOK_API_KEY=replace-with-a-random-64-char-hex-secret